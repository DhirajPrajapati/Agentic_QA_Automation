# Development environment
.venv/
.env
.env.*
!.env.example

# Runtime outputs — mounted as volumes at runtime, not baked into the image
outputs/
memory/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Version control
.git/
.gitignore

# CI / editor
.github/
.vscode/
.idea/
*.DS_Store

# Tests — not needed in the production image
tests/

# Documentation
*.md
!README.md
