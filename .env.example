# === MOCK MODE ===
# true = use local files (personal laptop)
# false = use real APIs (office laptop)
USE_MOCK=true

# === LLM MOCK — set false when org provides OpenAI key ===
USE_MOCK_LLM=true

# === LLM PROVIDER ===
LLM_PROVIDER=azure

# === AZURE OPENAI ===
# Only the endpoint is needed — no personal API key required
# Org manages authentication at infrastructure level
AZURE_OPENAI_ENDPOINT=https://your-org-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# === AZURE AUTH MODE ===
# managed_identity = Azure AD / DefaultAzureCredential (Scenario A)
#   Use when: org says "you need to be Azure AD joined" or "use your org login"
#   Needs: azure-identity package installed
#
# gateway = Org network proxy handles auth (Scenario B)
#   Use when: org says "just call the endpoint, it works on our network"
#   Default: gateway (simpler, most common enterprise setup)
AZURE_AUTH_MODE=gateway

# === STANDARD OPENAI — only if LLM_PROVIDER=openai ===
OPENAI_API_KEY=not_needed_if_using_azure
OPENAI_MODEL=gpt-4o

# === JIRA — only needed when USE_MOCK=false ===
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_jira_token

# === CONFLUENCE — only needed when USE_MOCK=false ===
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
CONFLUENCE_EMAIL=your.email@company.com
CONFLUENCE_API_TOKEN=your_confluence_token

# === UAT — only needed when USE_MOCK=false ===
UAT_BASE_URL=https://uat.yourportal.com

# === CHROMADB — always local ===
CHROMADB_PATH=./memory/chromadb

# === EMAIL — only needed when USE_MOCK=false ===
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USER=qa-reports@yourcompany.com
SMTP_PASSWORD=your_smtp_password
EMAIL_RECIPIENTS=qa@yourcompany.com
